import { groupBy, map, sortBy, sum } from "lodash";
import Tooltip from "@material-ui/core/Tooltip";
import TextField from "@material-ui/core/TextField";
import PropTypes from "prop-types";
import NumberFormat from "react-number-format";

function NumberFormatCustom(props) {
  const { inputRef, onChange, ...other } = props;

  return (
    <NumberFormat
      {...other}
      getInputRef={inputRef}
      onValueChange={(values) => {
        onChange({
          target: {
            name: props.name,
            value: values.value,
          },
        });
      }}
      style={{
        textAlign: "right",
        paddingRight: 10,
      }}
      thousandSeparator
      isNumericString
      prefix="Rp "
    />
  );
}
NumberFormatCustom.propTypes = {
  inputRef: PropTypes.func.isRequired,
  name: PropTypes.string.isRequired,
  onChange: PropTypes.func.isRequired,
};

export default function TabelPreviewAdmin(props) {
  const dataori = sortBy(props.data, (o) => o.kpusat);

  const data = groupBy(dataori, "golongan");
  const dataObj = map(data, (obj, key) => {
    return { head: key, values: obj };
  });

  const toRp = (val) => {
    const price = new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
    }).format(val);
    return price.toString().substring(0, price.toString().length - 3);
  };

  // data for row
  const dataforrow = map(
    groupBy(
      sortBy(props.data, (o) => o.kpembantu),
      "kpembantu"
    ),
    (obj, key) => {
      return { head: key, values: obj };
    }
  );
  console.log("dataObj:", dataObj);

  //var totalrow
  const totrow = [];
  dataforrow.forEach((item, index) => {
    var tr = 0;
    //obj map
    dataObj.forEach((itemg, idx) => {
      // gol
      itemg.values.forEach((cel, i) => {
        if (item.head === cel.kpembantu) {
          tr += Number(cel.saldo);
        }
      });
    });
    totrow.push(tr);
  });

  return (
    <div className="p-1 border overflow-x-auto">
      Preview Worksheet Mahasiswa :
      <table className="min-w-full table-fixed mb-4">
        <thead>
          <tr className="break-words bg-slate-50">
            <th className="min-w-10v max-w-10v px-2 border">
              Kode Rek Pembantu
            </th>
            <th className="min-w-15v px-2 border">Jumlah</th>
            <th className="p-0">
              <table className="w-full border-collapse">
                <tbody>
                  <tr >
                    {dataObj.map((item, index) => {
                      return (
                        <td
                          key={index}
                          colSpan={item.values.length}
                          rowSpan={item.head === "biaya produksi" ? 1 : 3}
                          className="py-2 capitalize border"
                        >
                          {item.head}
                        </td>
                      );
                    })}
                  </tr>
                  <tr>
                    {dataObj
                      .filter((x) => x.head === "biaya produksi")
                      .map((item, index) => {
                        const dataproduksi = groupBy(item.values, "departemen");
                        const headdepartement = map(
                          dataproduksi,
                          (obj, key) => {
                            return { head: key, values: obj };
                          }
                        );
                        return headdepartement.map((el, i) => (
                          <td
                            key={i}
                            colSpan={el.values.length}
                            className="py-1 capitalize border"
                          >
                            {el.head}
                          </td>
                        ));
                      })}
                  </tr>
                  <tr>
                    {dataObj
                      .filter((x) => x.head === "biaya produksi")
                      .map((item, index) => {
                        const dataseksi = groupBy(item.values, "seksi");
                        const headseksi = map(dataseksi, (obj, key) => {
                          return { head: key, values: obj };
                        });
                        return headseksi.map((el, i) => (
                          <td
                            key={i}
                            colSpan={el.values.length}
                            className="py-1 capitalize border"
                          >
                            {el.head}
                          </td>
                        ));
                      })}
                  </tr>
                  <tr>
                    {dataObj.map((item, index) => {
                      const datakode = groupBy(item.values, "kpusat");
                      const headkode = map(datakode, (obj, key) => {
                        return { head: key, values: obj };
                      });

                      return headkode.map((el, i) => (
                        <td
                          key={i}
                          colSpan={el.values.length}
                          className="py-1 capitalize min-w-15v max-w-15v border"
                        >
                          {el.head}
                        </td>
                      ));
                    })}
                  </tr>
                </tbody>
              </table>
            </th>
          </tr>
        </thead>
        <thead className="group">
          {/* Worksheet LIST */}
          {dataforrow.map((elr, index) => {
            return (
              <tr key={index} className="break-words">
                <th className="min-w-10v max-w-10v px-2 border">{elr.head}</th>
                <th className="min-w-15v px-2 border">
                  <span>{toRp(totrow[index])}</span>
                </th>
                <th className="p-0">
                  <table className="w-full border-collapse">
                    <tbody>
                      <tr>
                        {dataObj.map((item, idx) => {
                          //cel
                          const datakode = groupBy(item.values, "kpusat");
                          const headkode = map(datakode, (obj, key) => {
                            return { head: key, values: obj };
                          });
                          console.log("hk" + elr.head, headkode);

                          return headkode.map((cel, i) => {
                            return (
                              <td
                                key={i}
                                colSpan={cel.values.length}
                                className="capitalize border"
                              >
                                {elr.head === cel.kpembantu && cel.status ? (
                                  <div className="py-0 group-hover:bg-amber-50">
                                    <div className="relative px-1">
                                      <Tooltip
                                        title="jawaban benar mahasiswa"
                                        placement="bottom-start"
                                      >
                                        kok
                                      </Tooltip>
                                    </div>
                                  </div>
                                ) : (
                                  <div className="py-1">Hellos</div>
                                )}
                              </td>
                            );
                          });
                        })}
                      </tr>
                    </tbody>
                  </table>
                </th>
              </tr>
            );
          })}
          {/* TOTAL LIST */}
          <tr>
            <td className="py-2 text-center border table-cell">Jumlah</td>
            <td className="text-center border table-cell">
              <Tooltip title="jawaban benar mahasiswa" placement="bottom-start">
                <div className="py-2 group-hover:bg-amber-50">
                  {toRp(sum(totrow))}
                </div>
              </Tooltip>
            </td>
            <td className="p-0">
              <table className="w-full border-collapse">
                <tbody>
                  <tr>
                    {dataObj.map((item, index) => {
                      //cel
                      const datakode = groupBy(item.values, "kpusat");
                      const headkode = map(datakode, (obj, key) => {
                        return { head: key, values: obj };
                      });
                      return headkode.map((el, i) => (
                        <td
                          key={i}
                          className="p-0 capitalize min-w-15v max-w-15v border text-center"
                        >
                          {el.status ? (
                            <Tooltip
                              title="jawaban benar mahasiswa"
                              placement="bottom-start"
                            >
                              <div className="py-2 group-hover:bg-amber-50">
                                {toRp(el.saldo)}
                              </div>
                            </Tooltip>
                          ) : (
                            <div className="py-2">-</div>
                          )}
                        </td>
                      ));
                    })}
                  </tr>
                </tbody>
              </table>
            </td>
          </tr>
        </thead>
      </table>
    </div>
  );
}
